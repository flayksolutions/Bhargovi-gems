# SMTP account the site logs in to when sending enquiry emails.
# All server-only: no NEXT_PUBLIC_ prefix, never sent to the browser.

# Option A (simplest): a well-known provider name. Nodemailer fills in the
# host, port and TLS. e.g. gmail (also Google Workspace), outlook, zoho, yahoo.
# Note: Zoho India accounts need Option B with smtp.zoho.in.
SMTP_SERVICE=

# Option B: explicit server. Only used when SMTP_SERVICE is empty.
SMTP_HOST=
SMTP_PORT=465
# "true" for port 465 (SSL), "false" for 587 (STARTTLS)
SMTP_SECURE=true

# Mailbox login. Use an app password, not the real mailbox password.
SMTP_USER=
SMTP_PASS=

# Shown as the sender. Should be the same mailbox as SMTP_USER
# (Gmail/Zoho/M365 rewrite or reject a different From address).
MAIL_FROM="Bhargovi Gems Website <sales@bhargovigems.co>"

# Where enquiries are delivered.
MAIL_TO=sales@bhargovigems.co
